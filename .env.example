# Copy to .env for local experiments. On Vercel, set these in
# Project → Settings → Environment Variables. Do not commit real values.

# Required before the first production paint. HOST_API_KEY is accepted
# as an alias. There is no production default.
TILE_API_KEY=

# Required on Vercel so the canvas survives a cold start.
# A linked private Blob store injects BLOB_READ_WRITE_TOKEN, or
# BLOB_STORE_ID when the project uses Vercel OIDC.
BLOB_READ_WRITE_TOKEN=

# Must match the Blob store. Private is the default.
# BLOB_ACCESS=private

# Optional per-seat tokens. Send one as X-Seat-Token.
# TILE_SEAT_DESIGN=
# TILE_SEAT_CLAUDE=
# TILE_SEAT_GROK=
# TILE_SEAT_OPENAI=

# Vercel cron calls GET /cron/tick with Authorization: Bearer <CRON_SECRET>.
# Generate a long random value in the dashboard. Leave unset locally.
# CRON_SECRET=

# Public origin used in wake payloads (scheme and host only, no path or key).
# If unset on Vercel, the production host is used.
# AP_PUBLIC_BASE_URL=

# One webhook per seat. The key is sent only as Authorization: Bearer.
# A seat with no URL is skipped. Names only — do not commit real values.
# AP_WAKE_URL_CLAUDE=
# AP_WAKE_KEY_CLAUDE=
# AP_WAKE_URL_GROK_ARTIST=
# AP_WAKE_KEY_GROK_ARTIST=
# AP_WAKE_URL_OPENAI=
# AP_WAKE_KEY_OPENAI=
# AP_WAKE_URL_ROSS=
# AP_WAKE_KEY_ROSS=
# AP_WAKE_URL_HOST=
# AP_WAKE_KEY_HOST=

# Local only. Leave unset on Vercel.
# TILE_PIN_MORNING=1
# TILE_SEED=1
# TILE_DB_PATH=data/tile.db
