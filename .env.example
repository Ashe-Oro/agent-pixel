# Copy to .env for local experiments. On Vercel, set these in
# Project → Settings → Environment Variables. Do not commit real values.

# Required before the first production paint. HOST_API_KEY is accepted
# as an alias. There is no production default.
TILE_API_KEY=

# Required on Vercel so the canvas survives a cold start.
# A linked private Blob store injects BLOB_READ_WRITE_TOKEN, or
# BLOB_STORE_ID when the project uses Vercel OIDC.
BLOB_READ_WRITE_TOKEN=

# Must match the Blob store. Private is the default.
# BLOB_ACCESS=private

# Optional per-seat tokens. Send one as X-Seat-Token.
# TILE_SEAT_DESIGN=
# TILE_SEAT_ROSS=

# Vercel Cron sends this as Authorization: Bearer <value> to GET /cron/tick.
# CRON_SECRET=

# Public origin used in wake payloads. No trailing slash.
# TILE_PUBLIC_BASE_URL=

# JSON object keyed by seat id. Each value is url, plus secret and/or bearer,
# and optional events (slice_open, slice_closed, canvas_locked, awaiting_design, design_needed).
# bearer is sent as Authorization: Bearer. Omit events to mean slice_open.
# Any seat id is allowed. Do not commit real URLs, secrets, or sender keys.
# Host PUT /host/seats/{seat_id}/webhook overrides this map.
# TILE_SEAT_WEBHOOKS=

# Seconds a new canvas waits for the artist's design before a fallback palette.
# 0 applies the fallback on the next check. Default 3600 (1 hour).
# TILE_DESIGN_WAIT_SECONDS=3600

# Turn pacing for a solo canvas whose design omits "pacing".
# timed (default): an idle turn closes after TILE_SLICE_SECONDS.
# await_act: a turn waits for the painter's act, capped by the canvas window.
# TILE_SOLO_PACING=timed

# Seconds a new canvas stays open after turn 1 starts. Default 7200 (2 hours).
# Allowed 1-604800. Stored on the canvas. Older canvases keep their slice count.
# TILE_SOLO_WINDOW_SECONDS=7200

# Unique cells one Ross turn may place, including overwrites. Default 16384.
# Allowed 1-65536. Stored on the canvas. Older canvases stay uncapped.
# TILE_PIXELS_PER_TURN=16384

# Seconds one turn stays open. Default 180. Read when the process starts.
# TILE_SLICE_SECONDS=180

# Review wait on an older three-artist canvas. New canvases ignore it.
# 0 opens the next slice immediately. Default 75.
# TILE_NOTE_GATE_SECONDS=75

# Local only. Leave unset on Vercel.
# TILE_PIN_MORNING=1
# TILE_SEED=1
# TILE_DB_PATH=data/tile.db
